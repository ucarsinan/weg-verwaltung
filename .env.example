# Supabase (Frankfurt) — EU-Datenresidenz
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=       # server-only — NEVER expose to client

# Agent service (FastAPI + LangGraph)
AGENT_SERVICE_URL=http://localhost:8000
AGENT_SERVICE_SHARED_SECRET=     # request signing between web and agent

# LLM (choose one — Anthropic preferred for portfolio)
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# LLMOps: Langfuse (self-hosted or cloud)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Transactional mail
RESEND_API_KEY=

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
