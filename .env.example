# WEG-Verwaltung — canonical env schema. NEVER commit a populated .env.
# See docs/02-architecture-deployment.md §2.6 for env-separation rules.

# ── Supabase (Frankfurt, eu-central-1) ───────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co          # base URL, JWKS lives at /auth/v1/.well-known/jwks.json
SUPABASE_ANON_KEY=eyJ...                                # public; safe in browser
SUPABASE_SERVICE_ROLE_KEY=eyJ...                        # NEVER commit; rotate quarterly; bypasses RLS — server-only jobs
SUPABASE_PROJECT_REF=                                   # short ref used to build JWKS URL in FastAPI

# ── Next.js / Vercel (apps/web) ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co  # mirrors SUPABASE_URL for browser bundle
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...                    # mirrors SUPABASE_ANON_KEY
NEXT_PUBLIC_AGENT_URL=http://localhost:8000             # FastAPI base URL the browser/SSR layer calls
NEXT_PUBLIC_APP_URL=http://localhost:3000               # canonical site URL for email links, OG-tags
NEXTAUTH_SECRET=                                        # optional: only if NextAuth cookie-signing is layered atop Supabase

# ── FastAPI / Agent (apps/agent) ─────────────────────────────────────────────
# Agent reads SUPABASE_URL + SUPABASE_ANON_KEY above; user JWT is passed per-request (§2.4).
AGENT_INTERNAL_TOKEN=                                   # NEVER commit; bearer used by pg_cron → agent callbacks; rotate quarterly
REDIS_URL=redis://localhost:6379/0                      # token-bucket rate-limit + LangGraph thread locks

# ── LLM-Provider (Anthropic = main per §4.9) ─────────────────────────────────
ANTHROPIC_API_KEY=                                      # NEVER commit; rotate quarterly

# ── Langfuse (LLM-observability, EU cloud) ───────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=                                    # NEVER commit
LANGFUSE_HOST=https://cloud.langfuse.com                # Berlin GmbH, EU residency

# ── Resend (transactional mail) ──────────────────────────────────────────────
RESEND_API_KEY=                                         # NEVER commit

# ── App-internal ─────────────────────────────────────────────────────────────
AUDIT_HMAC_KEY=                                         # NEVER commit; signs AuditEvent hash-chain; prod: Supabase Vault; rotate quarterly
EMBEDDING_MODEL=BAAI/bge-m3                             # multilingual; pinned per §4
RERANKER_MODEL=BAAI/bge-reranker-v2-m3                  # cross-encoder rerank stage
